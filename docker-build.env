# Docker BuildKit Configuration
# Source this file before running docker-compose to enable BuildKit:
#   PowerShell: Get-Content docker-build.env | ForEach-Object { if ($_ -match '^([^#][^=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2], 'Process') } }
#   Bash: source docker-build.env
# Or set these manually:
#   PowerShell: $env:DOCKER_BUILDKIT = "1"; $env:COMPOSE_DOCKER_CLI_BUILD = "1"
#   Bash: export DOCKER_BUILDKIT=1 COMPOSE_DOCKER_CLI_BUILD=1
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
















