# Git and version control
.git
.gitignore
.gitattributes

# Python cache and compiled files
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*.so

# Virtual environments
venv/
env/
.venv/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
.env.development
.env.test
.env.production

# Logs
*.log
logs/
frontend/logs/

# Note: Dockerfile* and docker-compose*.yml are NOT ignored
# They must remain in build context for remote builds (GCP/Cloud Build)

# Temporary files
tmp/
temp/
.tmp/

# Node.js and frontend (NOT needed in backend image)
node_modules/
frontend/
.next/
dist/
*.tsbuildinfo

# Cache directories
.cache/
cache/
.huggingface/
.pnpm-store/
.yarn/cache/
.turbo/

# Backup files
*.bak
*.backup
*.old

# Test files
test/
tests/
*_test.py
test_*.py
test_docs/

# Scraper tooling (local dev only)
Scraper/

# ============================================================================
# CRITICAL: Exclude large directories that cause 4GB+ bloat
# ============================================================================

# RAG artifacts and vector stores (NOT needed - using Cloud Storage + PostgreSQL)
latest_model/
**/latest_model/

# Document data directory (NOT needed - documents in GCS)
data/
**/data/

# Document files (NOT needed - in GCS)
*.pdf
*.docx
*.xlsx
*.csv

# SQLite databases (NOT needed - using PostgreSQL in GCP)
*.db
*.sqlite
*.sqlite-*
*.sql

# Model files (NOT needed - download at runtime)
*.bin
*.safetensors
models/
checkpoints/
