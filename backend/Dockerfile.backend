# Lightweight Dockerfile for RAG App - Development & Production
# Models download at runtime, not during build

# Build argument to determine environment
ARG BUILD_ENV=production

# =============================================================================
# Base Stage - Minimal system dependencies
# =============================================================================
FROM python:3.11-slim-bookworm AS base

# Set environment variables
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install minimal runtime dependencies only
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        curl \
        git \
        libgomp1 \
        && rm -rf /var/lib/apt/lists/*

# Create non-root user early
RUN useradd -m -u 1000 appuser

# =============================================================================
# Dependencies Stage - Install Python packages (with build tools)
# =============================================================================
FROM base AS dependencies

# Redeclare ARG for this stage
ARG BUILD_ENV=production

WORKDIR /app

# Install build-essential ONLY in this stage for compiling Python packages
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        && rm -rf /var/lib/apt/lists/*

# Copy only backend requirements first for better layer caching
# This COPY command creates a layer that only invalidates when requirements.txt changes
COPY backend/requirements.txt /tmp/requirements.txt
COPY backend/requirements-dev.txt /tmp/requirements-dev.txt

# Upgrade pip and install dependencies in one step for better caching
# This layer will only rebuild when requirements.txt changes (due to COPY above)
# Using --no-cache-dir=off to leverage BuildKit cache mount properly
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install --no-cache-dir -r /tmp/requirements.txt

# Pre-download Hugging Face / sentence-transformers models into a dedicated
# cache directory so they are baked into the image and available on Cloud Run.
# All models must be downloaded here for offline operation in production.
ENV HF_HOME=/app/.cache/huggingface \
    TRANSFORMERS_CACHE=/app/.cache/huggingface \
    HF_DATASETS_CACHE=/app/.cache/huggingface \
    SENTENCE_TRANSFORMERS_HOME=/app/.cache/huggingface

# Pre-download all required embedding models using inline script
# This ensures models are available offline in production
# Models are downloaded during build and baked into the image
RUN mkdir -p /app/.cache/huggingface && \
    printf '%s\n' \
        'import os' \
        'import sys' \
        'from sentence_transformers import SentenceTransformer' \
        '' \
        'MODELS = [' \
        '    "BAAI/bge-base-en-v1.5",' \
        '    "BAAI/bge-large-en-v1.5",' \
        '    "sentence-transformers/all-MiniLM-L6-v2",' \
        '    "sentence-transformers/all-mpnet-base-v2",' \
        ']' \
        '' \
        'cache_dir = os.getenv("HF_HOME", "/app/.cache/huggingface")' \
        'os.makedirs(cache_dir, exist_ok=True)' \
        '' \
        'print("📥 Pre-downloading embedding models...")' \
        'for model_name in MODELS:' \
        '    try:' \
        '        print(f"   Downloading: {model_name}")' \
        '        model = SentenceTransformer(model_name, cache_folder=cache_dir)' \
        '        test_embedding = model.encode("test", convert_to_numpy=True)' \
        '        print(f"   ✅ {model_name} (dim: {len(test_embedding)})")' \
        '    except Exception as e:' \
        '        print(f"   ❌ {model_name}: {e}")' \
        '        if model_name == "BAAI/bge-base-en-v1.5":' \
        '            print("❌ ERROR: Primary model failed to download")' \
        '            sys.exit(1)' \
        '' \
        'print("✅ All models downloaded successfully")' \
        > /tmp/download_models.py && \
    python /tmp/download_models.py && \
    rm /tmp/download_models.py

# Conditionally install development dependencies
# This layer only rebuilds when BUILD_ENV changes or dependencies stage is invalidated
RUN if [ "$BUILD_ENV" = "development" ]; then \
        pip install watchdog python-dotenv && \
        pip install --no-cache-dir -r /tmp/requirements-dev.txt; \
    fi

# =============================================================================
# Final Stage - Application setup (no build tools, no models)
# =============================================================================
FROM base AS final

# Redeclare ARG for this stage
ARG BUILD_ENV=production

# Set as ENV so it's available at runtime
ENV BUILD_ENV=${BUILD_ENV}
# ENV can be overridden at runtime via docker-compose or docker run
# Default to 'dev' if not set (can be overridden at runtime)
ENV ENV=dev

# Set HuggingFace cache directory (models download here at runtime)
# Use an application-owned, writable directory under /app instead of /tmp/hf
# so Cloud Run permission issues on /tmp/hf/hub are avoided.
# These can still be overridden at runtime via environment variables if needed.
ENV HF_HOME=/app/.cache/huggingface
ENV TRANSFORMERS_CACHE=/app/.cache/huggingface
ENV HF_DATASETS_CACHE=/app/.cache/huggingface
ENV SENTENCE_TRANSFORMERS_HOME=/app/.cache/huggingface

# Create necessary directories
# TODO: In production, mount GCS bucket for /data and use vector DB for latest_model
RUN mkdir -p /app/data /app/latest_model /app/logs /app/storage /app/.cache/huggingface

# Copy Python dependencies from dependencies stage (no build tools)
COPY --from=dependencies /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=dependencies /usr/local/bin /usr/local/bin

# Copy pre-downloaded Hugging Face cache from dependencies stage
COPY --from=dependencies /app/.cache/huggingface /app/.cache/huggingface

# Set working directory for app code
WORKDIR /app

# Copy entrypoint script to run migrations then start the backend
COPY backend/entrypoint.sh /app/entrypoint.sh
RUN sed -i 's/\r$//' /app/entrypoint.sh && chmod +x /app/entrypoint.sh

# Ensure Alembic can run inside Docker by including config file
RUN mkdir -p /app/backend/migrations
COPY backend/migrations/alembic.ini /app/backend/migrations/alembic.ini

# Copy pyproject.toml (for project configuration, used by some tools)
COPY pyproject.toml /app/pyproject.toml

# Create health check script (uses PORT env var, defaults to 8080 for GCP)
# Uses /healthz endpoint which has zero dependencies and returns immediately
RUN printf '#!/bin/bash\nPORT=${PORT:-8080}\nif curl -f http://localhost:${PORT}/healthz > /dev/null 2>&1; then\n    exit 0\nelse\n    exit 1\nfi\n' > /app/healthcheck.sh && sed -i 's/\r$//' /app/healthcheck.sh && chmod +x /app/healthcheck.sh

# Copy ONLY backend code (exclude data/, latest_model/, frontend/, etc.)
# .dockerignore ensures large directories are excluded from build context
COPY backend/ /app/backend/

# Create backend startup script after project files are copied (avoids CRLF overwrites)
RUN cat <<'EOF' > /app/run_backend.sh
#!/bin/bash
set -e

# Load .env file ONLY in development (not in production)
# In production, Cloud Run environment variables must always win
if [ -f ".env" ] && [ "${ENV:-dev}" != "prod" ] && [ "${ENV:-dev}" != "production" ] && [ "${ENV:-dev}" != "cloud" ]; then
    echo "📋 Loading environment variables from .env file (dev mode only)..."
    set -a
    while IFS= read -r line || [ -n "$line" ]; do
        cleaned_line=$(echo "$line" | tr -d "\r")
        if [[ -z "$cleaned_line" || "$cleaned_line" =~ ^[[:space:]]*# ]]; then
            continue
        fi
        if echo "$cleaned_line" | grep -q "="; then
            export "$cleaned_line"
        fi
    done < .env
    set +a
    echo "✅ Environment variables loaded from .env file"
else
    if [ -f ".env" ]; then
        echo "⚠️  .env file found but skipped (production mode - using Cloud Run env vars only)"
    fi
fi

echo "=========================================="
if [ "$BUILD_ENV" = "development" ]; then
    echo "🔧 DuraFlex Technical Assistant (DEV)"
else
    echo "🔧 DuraFlex Technical Assistant"
fi
echo "=========================================="
echo ""
echo "📥 Models are pre-downloaded in image (offline mode enabled)..."
echo ""

# Check if index exists
if [ -d "latest_model" ] && [ -f "latest_model/docstore.json" ]; then
    echo "✅ RAG index found in latest_model/"
    chunks=$(python -c "import json; print(len(json.load(open('latest_model/docstore.json'))['docstore/data']))" 2>/dev/null || echo "unknown")
    echo "   📊 Indexed chunks: ${chunks}"
    echo ""
else
    # Detect Cloud Run deployment and NEVER ingest
    if [ -n "$K_SERVICE" ] || [ -n "$K_REVISION" ]; then
        echo "ℹ️ RAG Index not found - Cloud Run detected, ingestion permanently disabled"
        echo "   (Cloud Run MUST receive a pre-built index or use a vector DB)"
        echo ""
    else
        # Local development only
        ENABLE_INGESTION=${ENABLE_INGESTION_ON_STARTUP:-false}
        if [ "$ENABLE_INGESTION" = "true" ]; then
            echo "🔄 ENABLE_INGESTION_ON_STARTUP=true - Running ingestion..."
            python -m backend.ingest
            echo "✅ Ingestion complete!"
        else
            echo "⏭️  Skipping ingestion locally (ENABLE_INGESTION_ON_STARTUP=${ENABLE_INGESTION})"
        fi
    fi
fi

echo "🚀 Starting FastAPI backend server..."
echo ""
PORT=${PORT:-8080}
echo "API will be available at: http://localhost:${PORT}"
echo "API docs available at: http://localhost:${PORT}/docs"
echo ""
echo "⚠️  Note: This container runs the backend API only."
echo "   Use docker-compose.yml to run both backend and frontend together."
echo ""

# Start FastAPI with environment-specific settings
# Use PORT environment variable (Cloud Run sets this to 8080, default to 8080 for GCP)
PORT=${PORT:-8080}

if [ "$BUILD_ENV" = "development" ]; then
    exec python -m backend.api --host 0.0.0.0 --port "${PORT}" --dev --reload
else
    # Production: Use Gunicorn with multiple workers
    # Use 1 worker for dev environment to reduce log duplication, 3 for production
    ENV_TYPE=${ENV:-${NODE_ENV:-production}}
    if [ "$ENV_TYPE" = "dev" ] || [ "$ENV_TYPE" = "development" ]; then
        DEFAULT_WORKERS=1
    else
        DEFAULT_WORKERS=3
    fi
    WORKERS=${GUNICORN_WORKERS:-$DEFAULT_WORKERS}
    TIMEOUT=${GUNICORN_TIMEOUT:-300}
    MAX_REQUESTS=${GUNICORN_MAX_REQUESTS:-1000}
    
    exec gunicorn backend.api:app \
        --workers "${WORKERS}" \
        --worker-class uvicorn.workers.UvicornWorker \
        --bind "0.0.0.0:${PORT}" \
        --timeout "${TIMEOUT}" \
        --keep-alive 5 \
        --max-requests "${MAX_REQUESTS}" \
        --max-requests-jitter 100 \
        --access-logfile "-" \
        --error-logfile "-"
fi
EOF
RUN sed -i 's/\r$//' /app/run_backend.sh && chmod +x /app/run_backend.sh

# Database is managed via DATABASE_URL environment variable (PostgreSQL)

# Set ownership and permissions so appuser can write to caches and app directories
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# EXPOSE is just documentation - Cloud Run uses PORT env var
# Default to 8080 for GCP Cloud Run compatibility
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=120s --retries=3 \
    CMD /app/healthcheck.sh || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]

