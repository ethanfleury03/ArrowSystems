# =============================================================================
# .env.example - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control - it contains secrets!
#
# This file documents all environment variables used by the DuraFlex RAG system.
# Variables are organized by section for clarity.
# =============================================================================

# =============================================================================
# GLOBAL CONFIGURATION
# =============================================================================

# Environment mode: "dev", "development", "prod", "production", or "cloud"
# - dev/development: Development mode (SQLite, auto-migrations, verbose errors)
# - prod/production/cloud: Production mode (requires PostgreSQL, strict validation)
# Default: "dev"
ENV=dev

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------

# JWT Secret Key - REQUIRED in production
# Must be at least 32 characters long and not a common default value
# Generate a secure random string: openssl rand -hex 32
# Default (dev only): "dev-secret-key-not-for-production-use-only"
JWT_SECRET_KEY=your-super-secret-jwt-key-at-least-32-characters-long-change-this-in-production

# JWT Algorithm - OPTIONAL
# Algorithm used for JWT token signing
# Default: "HS256"
JWT_ALGORITHM=HS256

# JWT Access Token Expiration - OPTIONAL
# Token expiration time in minutes
# Default: 60
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins - REQUIRED in production
# Comma-separated list of allowed origins (no spaces, no wildcards in prod)
# Example: "https://example.com,https://www.example.com"
# Default (dev only): "http://localhost:3000,http://127.0.0.1:3000"
CORS_ALLOWED_ORIGINS=https://your-production-domain.com,https://www.your-production-domain.com

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# Database URL - REQUIRED in production
# PostgreSQL connection string for production
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/duraflex_db
# Note: SQLite is automatically used in dev mode if not provided
DATABASE_URL=postgresql://postgres:password@localhost:5432/duraflex_db

# SQLite Database Path - OPTIONAL (dev only)
# Path to SQLite database file (only used in development mode)
# Default: "./backend/database.sqlite"
SQLITE_DB_PATH=./backend/database.sqlite

# -----------------------------------------------------------------------------
# External API Keys
# -----------------------------------------------------------------------------

# Anthropic API Key - REQUIRED for Claude API features
# Get your API key from: https://console.anthropic.com/
# Required for: Intent classification, query rewriting, answer generation
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key-here

# -----------------------------------------------------------------------------
# Server Configuration (Gunicorn)
# -----------------------------------------------------------------------------

# Gunicorn Workers - OPTIONAL
# Number of worker processes (1 for dev, 3+ for production)
# Default: 1 (dev) or 3 (prod)
GUNICORN_WORKERS=3

# Gunicorn Timeout - OPTIONAL
# Request timeout in seconds
# Default: 300
GUNICORN_TIMEOUT=300

# Gunicorn Max Requests - OPTIONAL
# Maximum number of requests a worker will process before recycling
# Default: 1000
GUNICORN_MAX_REQUESTS=1000

# -----------------------------------------------------------------------------
# HuggingFace Cache Configuration
# -----------------------------------------------------------------------------

# HuggingFace Home Directory - OPTIONAL
# Directory where HuggingFace models are cached
# Default: "/app/.cache/huggingface" (Docker) or system default (local)
HF_HOME=/app/.cache/huggingface

# Transformers Cache - OPTIONAL
# Directory for transformers model cache
# Default: Same as HF_HOME
TRANSFORMERS_CACHE=/app/.cache/huggingface

# HuggingFace Datasets Cache - OPTIONAL
# Directory for HuggingFace datasets cache
# Default: Same as HF_HOME
HF_DATASETS_CACHE=/app/.cache/huggingface

# Sentence Transformers Home - OPTIONAL
# Directory for sentence-transformers cache
# Default: Same as HF_HOME
SENTENCE_TRANSFORMERS_HOME=/app/.cache/huggingface

# -----------------------------------------------------------------------------
# Seed User Accounts (Optional)
# -----------------------------------------------------------------------------

# Admin Seed User - OPTIONAL
# These accounts are created on first startup if they don't exist
# Leave empty to skip seed user creation

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Administrator

# Technician Seed User - OPTIONAL
SEED_TECH_EMAIL=tech@example.com
SEED_TECH_PASSWORD=tech123
SEED_TECH_NAME=Technician

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# API Log File Path - OPTIONAL
# Path to API log file (relative to application root)
# Default: "api.log"
API_LOG_FILE_PATH=api.log

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Node Environment
# -----------------------------------------------------------------------------

# Node Environment - REQUIRED
# Set to "production" for production builds, "development" for dev
# Default: "development"
NODE_ENV=production

# -----------------------------------------------------------------------------
# Session & Authentication
# -----------------------------------------------------------------------------

# Session Secret - REQUIRED in production
# Secret key for encrypting session cookies (must be >= 32 characters)
# Generate a secure random string: openssl rand -hex 32
# Default (dev only): "dev-session-secret-not-for-production"
SESSION_SECRET=your-super-secret-session-key-at-least-32-characters-long-change-this-in-production

# -----------------------------------------------------------------------------
# Backend API URLs
# -----------------------------------------------------------------------------

# Public API URL - REQUIRED in production
# Public-facing URL of the backend API (used by client-side code)
# Example: "https://api.your-domain.com" or "http://localhost:8000" (dev)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend URL - OPTIONAL
# Server-side backend URL (used by Next.js API routes)
# Default: "http://backend:8000" (Docker) or "http://localhost:8000" (local)
BACKEND_URL=http://backend:8000

# Server Backend URL - OPTIONAL
# Alternative server-side backend URL
# Default: Same as BACKEND_URL
SERVER_BACKEND_URL=http://backend:8000

# Public Server Backend URL - OPTIONAL
# Public server-side backend URL (exposed to client)
# Default: Same as BACKEND_URL
NEXT_PUBLIC_SERVER_BACKEND_URL=http://backend:8000

# Use Local Backend - OPTIONAL
# Boolean flag to use local backend (for development)
# Default: false
NEXT_PUBLIC_USE_LOCAL_BACKEND=false

# Local Backend URL - OPTIONAL
# URL for local backend when NEXT_PUBLIC_USE_LOCAL_BACKEND is true
# Default: "http://localhost:8000"
NEXT_PUBLIC_LOCAL_BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Public Log Level - OPTIONAL
# Client-side log level: "debug", "info", "warn", or "error"
# Default: "debug" (dev) or "error" (prod)
NEXT_PUBLIC_LOG_LEVEL=error

# =============================================================================
# OPTIONAL / ADVANCED CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Build Configuration
# -----------------------------------------------------------------------------

# Build Environment - OPTIONAL (Docker build arg)
# Set to "development" for dev builds, "production" for prod builds
# Default: "production"
# Note: This is typically set in docker-compose.yml, not .env
# BUILD_ENV=production

# -----------------------------------------------------------------------------
# Legacy/Deprecated Variables
# -----------------------------------------------------------------------------

# These variables may be referenced in older code but are not actively used:
# - ADMIN_EMAIL (use SEED_ADMIN_EMAIL instead)
# - ADMIN_PASSWORD (use SEED_ADMIN_PASSWORD instead)
