{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: Cloud SQL Proxy",
      "type": "shell",
      "command": "if (Test-Path .\\tools\\cloud-sql-proxy.exe) { .\\tools\\cloud-sql-proxy.exe arrow-rag-support-prod:us-central1:rag-postgres --port 5433 } else { Write-Host 'ERROR: tools\\cloud-sql-proxy.exe not found. Please download it from https://cloud.google.com/sql/docs/postgres/sql-proxy#install' -ForegroundColor Red; exit 1 }",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "dev",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Dev: Backend (FastAPI)",
      "type": "shell",
      "command": "$env:DISABLE_RAG='true'; python backend/run_uvicorn_dev.py",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "dev",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Dev: Frontend (Next.js)",
      "type": "shell",
      "command": "Set-Location frontend; npm run dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "dev",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Dev: All (No Docker)",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Dev: Backend (FastAPI)",
        "Dev: Frontend (Next.js)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Dev: All (Proxy + API + Web)",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Dev: Cloud SQL Proxy",
        "Dev: Backend (FastAPI)",
        "Dev: Frontend (Next.js)"
      ],
      "problemMatcher": []
    }
  ]
}
