# Backend Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env files to git (they contain secrets)

# Environment (dev/prod)
ENV=dev

# Disable RAG (skip RAG initialization, model downloads, and imports)
# Set to true to disable RAG completely for fast local development
DISABLE_RAG=false

# Fast Dev Mode (skip heavy operations for local UI development)
# DEV_FAST=true enables all skip flags (DEV_SKIP_DB, DEV_SKIP_GCS)
# Individual flags can also be set independently
DEV_FAST=false
DEV_SKIP_DB=false
DEV_SKIP_GCS=false

# Database Configuration (REQUIRED unless DEV_SKIP_DB=true)
# PostgreSQL connection string - SQLite is NOT supported
# Format: postgresql://user:password@host:port/database
# Example for local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arrow_dev

# Session Secret (optional in dev, has default)
# FRONTEND_SESSION_SECRET=dev-session-secret-not-for-production

# JWT Secret (optional in dev, has default)
# JWT_SECRET_KEY=dev-secret-key-not-for-production-use-only

# CORS Origins (optional in dev, defaults to localhost:3000)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Anthropic API Key (optional - for Claude LLM integration)
# ANTHROPIC_API_KEY=your-api-key-here

# GCS Configuration (optional in dev)
# DOCS_GCS_BUCKET=your-bucket-name
# DOCS_GCS_PREFIX=

# Rate Limiting (optional, defaults shown)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_GLOBAL=100/minute
# RATE_LIMIT_LOGIN=5/minute
# RATE_LIMIT_QUERY=10/minute
