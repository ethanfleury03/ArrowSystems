# Dockerfile for FastAPI Backend
# Lightweight production-ready container for the RAG API server

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    gosu \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip first (with retry logic)
RUN pip install --upgrade pip || \
    (echo "pip upgrade failed, retrying..." && pip install --upgrade pip)

# Install PyTorch separately with CPU-only build (much faster for GCP)
# This is ~300MB vs ~900MB for full CUDA build
# Retry logic for network resilience
RUN pip install --no-cache-dir --timeout=300 --default-timeout=300 \
    torch==2.5.1 \
    --index-url https://download.pytorch.org/whl/cpu || \
    (echo "PyTorch install failed, retrying..." && \
     pip install --no-cache-dir --timeout=600 --default-timeout=600 \
     torch==2.5.1 \
     --index-url https://download.pytorch.org/whl/cpu)

# Copy requirements first for better caching
COPY backend/requirements.txt ./requirements.txt

# Install remaining Python dependencies
# Filter out torch from requirements using Python since we installed it above with CPU build
# Retry logic for network resilience
RUN python -c "import sys; lines = [l for l in open('requirements.txt') if not l.startswith('torch==')]; open('requirements_no_torch.txt', 'w').writelines(lines)" && \
    (pip install --no-cache-dir --timeout=300 --default-timeout=300 -r requirements_no_torch.txt || \
     (echo "Requirements install failed, retrying..." && \
      pip install --no-cache-dir --timeout=600 --default-timeout=600 -r requirements_no_torch.txt))

# Create cache directory structure and user setup before copying code
# This allows these steps to be cached separately from code changes
RUN mkdir -p /app/.cache/huggingface/hub

# Pre-download embedding and reranker models during build
# This ensures models are in the image cache and no network calls are needed at runtime
# CRITICAL: These models must match what the RAG pipeline expects at runtime
# CRITICAL: Use the EXACT same loading mechanism as runtime (SentenceTransformer/CrossEncoder)
ENV HF_HOME=/app/.cache/huggingface
ENV SENTENCE_TRANSFORMERS_HOME=/app/.cache/huggingface
ENV TRANSFORMERS_CACHE=/app/.cache/huggingface
ENV HF_HUB_ENABLE_HF_TRANSFER=0

RUN python - <<'PY'
import os
import glob
print("[BUILD] Pre-downloading embedding and reranker models...")
print("[BUILD] VERIFICATION_MARKER: model_pre_download_start")

# CRITICAL FIX: Use consistent cache directory structure
# Runtime expects models in /app/.cache/huggingface/hub/
# Set environment variables to match runtime expectations
cache_base = "/app/.cache/huggingface"
cache_hub = os.path.join(cache_base, "hub")
os.makedirs(cache_hub, exist_ok=True)

# Set environment variables to match runtime
os.environ["HF_HOME"] = cache_base
os.environ["HF_HUB_CACHE"] = cache_hub
os.environ["TRANSFORMERS_CACHE"] = cache_base
os.environ["SENTENCE_TRANSFORMERS_HOME"] = cache_base

print(f"[BUILD] Cache base directory: {cache_base}")
print(f"[BUILD] Cache hub directory: {cache_hub}")

# Download embedding model (BAAI/bge-large-en-v1.5 - 1024 dimensions)
# CRITICAL: Runtime uses SentenceTransformer via HuggingFaceEmbedding wrapper
# So we must use SentenceTransformer here to download all required files
from sentence_transformers import SentenceTransformer
print("[BUILD] Downloading BAAI/bge-large-en-v1.5 (embedding model)...")
print("[BUILD] VERIFICATION_MARKER: embedding_download_start")
try:
    embed_model = SentenceTransformer("BAAI/bge-large-en-v1.5", cache_folder=cache_hub)
except TypeError:
    # Fallback for newer versions
    embed_model = SentenceTransformer("BAAI/bge-large-en-v1.5")
dim = embed_model.get_sentence_embedding_dimension()
print(f"[BUILD] Embedding model downloaded. Dimension: {dim} (expected: 1024)")
print("[BUILD] VERIFICATION_MARKER: embedding_download_done")
if dim != 1024:
    raise RuntimeError(f"Embedding dimension mismatch: expected 1024, got {dim}")

# Download reranker model (BAAI/bge-reranker-large)
# CRITICAL: Runtime uses CrossEncoder from sentence_transformers
# So we must use CrossEncoder here to download all required files
from sentence_transformers import CrossEncoder
print("[BUILD] Downloading BAAI/bge-reranker-large (reranker model)...")
print("[BUILD] VERIFICATION_MARKER: reranker_download_start")
try:
    # Use cache_folder parameter if available (older sentence-transformers)
    try:
        reranker = CrossEncoder("BAAI/bge-reranker-large", cache_folder=cache_hub, device="cpu")
    except TypeError:
        # Fallback for newer versions that don't support cache_folder
        # Environment variables should be sufficient
        reranker = CrossEncoder("BAAI/bge-reranker-large", device="cpu")
    
    # Verify reranker model files exist
    reranker_pattern = os.path.join(cache_hub, "models--BAAI--bge-reranker-large", "**", "*.safetensors")
    reranker_files = glob.glob(reranker_pattern, recursive=True)
    if not reranker_files:
        # Also check for .bin files (older format)
        reranker_pattern_bin = os.path.join(cache_hub, "models--BAAI--bge-reranker-large", "**", "*.bin")
        reranker_files = glob.glob(reranker_pattern_bin, recursive=True)
    
    if reranker_files:
        print(f"[BUILD] Reranker model downloaded. Found {len(reranker_files)} model file(s).")
        print("[BUILD] VERIFICATION_MARKER: reranker_download_done")
    else:
        print("[BUILD] WARNING: Reranker loaded but model files not found in expected location")
        print("[BUILD] VERIFICATION_MARKER: reranker_download_done")
except Exception as e:
    print(f"[BUILD] Reranker download error: {e}")
    import traceback
    print(f"[BUILD] Reranker error traceback: {traceback.format_exc()}")
    print("[BUILD] VERIFICATION_MARKER: reranker_download_failed")
    raise  # Make reranker download failure fatal to catch issues early

# Verify cache structure
print(f"[BUILD] Model pre-download complete. Verifying cache structure...")
import subprocess
subprocess.run(["ls", "-la", cache_base], check=False)
if os.path.exists(cache_hub):
    subprocess.run(["find", cache_hub, "-name", "*.safetensors", "-o", "-name", "*.bin"], check=False)
    subprocess.run(["du", "-sh", cache_hub], check=False)
print("[BUILD] VERIFICATION_MARKER: model_pre_download_done")
PY

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash app

# CRITICAL: Set ownership of cache directory to app user BEFORE copying code
# This ensures the app user can read the models at runtime
RUN chown -R app:app /app/.cache/huggingface

# Copy entrypoint script (if it exists separately, otherwise it will be in COPY . .)
# Copy it before the full code copy so it can be cached separately if it changes less frequently
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Copy Gunicorn startup script
COPY deployment/start-gunicorn.sh /start-gunicorn.sh
RUN chmod +x /start-gunicorn.sh

# Copy application code
COPY . .

# Ensure SQLite database file exists
RUN touch /app/database.sqlite

# Set ownership after copying code (including cache directory)
# CRITICAL: Ensure cache directory is accessible to app user
RUN chown -R app:app /app && \
    chmod -R u+rwX /app/.cache/huggingface && \
    ls -la /app/.cache/huggingface | head -20
# Don't switch to app user yet - entrypoint will do it after fixing permissions
# USER app

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV HF_HUB_ENABLE_HF_TRANSFER=0

# Expose port (Cloud Run uses PORT env var, but EXPOSE documents expected port)
EXPOSE 8080

# Health check (uses PORT env var via Cloud Run)
HEALTHCHECK --interval=30s --timeout=30s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8080}/health || exit 1

# Set entrypoint
ENTRYPOINT ["/docker-entrypoint.sh"]

# Run the FastAPI server with Gunicorn via startup script
# The script makes timeout/port/workers explicit and logs them for observability
CMD ["/start-gunicorn.sh"]
